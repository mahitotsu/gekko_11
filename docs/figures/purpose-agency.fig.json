{
  "kind": "sequence",
  "title": "代理人が間に入る取引で、取引のときに検証し、事後に確かめる",
  "desc": "取引のとき: 顧客が営業員に本人確認書類を見せて申込みを頼み、営業員は書類で本人を確かめる。顧客が申込書に署名し、営業員は申込書と確認の記録を事務担当へ運ぶ。事務担当は、営業員の名乗りを営業員の名簿と照らし、申込書を点検してから、保険会社のシステムに入力する。事後: 事務担当は証券を、営業員を通さずに顧客へ直接送り、顧客は手元の写しと見比べる。会社は、営業員を監査し、記録を保存する。",
  "participants": [
    {
      "id": "cust",
      "name": "顧客",
      "sub": "本人"
    },
    {
      "id": "rep",
      "name": "営業員",
      "sub": "代理人",
      "cls": "k1"
    },
    {
      "id": "clerk",
      "name": "事務担当",
      "sub": "事務センター"
    },
    {
      "id": "sys",
      "name": "保険会社の",
      "sub": "システム"
    }
  ],
  "items": [
    {
      "note": {
        "over": [
          "cust",
          "sys"
        ],
        "text": "取引のときの検証"
      }
    },
    {
      "from": "cust",
      "to": "rep",
      "label": "本人確認書類を見せて、申込む"
    },
    {
      "note": {
        "over": [
          "rep"
        ],
        "text": "書類で本人を確かめる"
      }
    },
    {
      "from": "cust",
      "to": "rep",
      "label": "申込書に署名する"
    },
    {
      "from": "rep",
      "to": "clerk",
      "label": "申込書と本人確認の記録を運ぶ"
    },
    {
      "note": {
        "over": [
          "clerk",
          "sys"
        ],
        "text": "名乗りを営業員の名簿と照らし、申込書を点検する"
      }
    },
    {
      "from": "clerk",
      "to": "sys",
      "label": "点検を終えた申込みを入力する"
    },
    {
      "note": {
        "over": [
          "cust",
          "sys"
        ],
        "text": "事後の確認と監査"
      }
    },
    {
      "from": "clerk",
      "to": "cust",
      "label": "証券を直接送る（営業員を通らない）"
    },
    {
      "note": {
        "over": [
          "cust"
        ],
        "text": "手元の写しと見比べる"
      }
    },
    {
      "note": {
        "over": [
          "clerk",
          "sys"
        ],
        "text": "会社が営業員を監査し、記録を保存する"
      }
    }
  ],
  "note": "窓口の話は、公開されている規則を手がかりに組み立てたたとえ話である。"
}
