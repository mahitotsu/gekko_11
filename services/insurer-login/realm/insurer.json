      "serviceAccountClientId": "insurer-auth",
      "clientRoles": {
        "realm-management": [
          "view-users"
        ]
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "spire",
      "providerId": "spiffe",
      "enabled": true,
      "config": {
        "trustDomain": "spiffe://${TRUST_DOMAIN}",
        "bundleEndpoint": "https://spire-server.spire.svc.cluster.local:8443"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "apply",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "sales-agent",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "may_act",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "may_act",
            "claim.value": "{\"iss\":\"${AUTH_ISSUER}\",\"sub\":\"sales-agent\"}",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "verified_claims",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "verified_claims",
            "claim.name": "verified_claims",
            "jsonType.label": "JSON",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "issuance",
          "protocol": "openid-connect",
          "protocolMapper": "insurer-issuance-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "passkeys",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "insurer-auth",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "customer-app",
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${APP_ORIGIN}/callback"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [
        "apply",
        "passkeys"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "dpop.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true",
        "use.refresh.tokens": "true",
        "post.logout.redirect.uris": "${APP_ORIGIN}/",
        "jwt.credential.issuer": "spire",
        "jwt.credential.sub": "spiffe://${TRUST_DOMAIN}/ns/${NAMESPACE}/sa/customer-app"
      }
    },
    {
      "clientId": "insurer-audit",
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "${AUDIT_ORIGIN}/login/oauth2/code/insurer-login"
      ],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "false",
        "post.logout.redirect.uris": "${AUDIT_ORIGIN}/",
        "jwt.credential.issuer": "spire",
        "jwt.credential.sub": "spiffe://${TRUST_DOMAIN}/ns/${NAMESPACE}/sa/insurer-audit"
      }
    },
    {
      "clientId": "insurer-auth",
      "publicClient": false,
      "clientAuthenticatorType": "federated-jwt",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "defaultClientScopes": [
        "basic"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "use.refresh.tokens": "false",
        "jwt.credential.issuer": "spire",
        "jwt.credential.sub": "spiffe://${TRUST_DOMAIN}/ns/${NAMESPACE}/sa/insurer-auth"
      },
      "protocolMappers": [
        {
          "name": "realm-management roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "config": {
            "usermodel.clientRoleMapping.clientId": "realm-management",
            "claim.name": "resource_access.realm-management.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ]
}
