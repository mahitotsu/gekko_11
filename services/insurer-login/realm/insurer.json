{
  "realm": "insurer",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER"
      },
      {
        "name": "AUDITOR"
      }
    ]
  },
  "users": [
