{
  "realm": "insurer",
  "loginTheme": "insurer",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 3600,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "webAuthnPolicyPasswordlessRpId": "${NAMESPACE}.localhost",
  "webAuthnPolicyPasswordlessRpEntityName": "教材保険会社",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "webAuthnPolicyPasswordlessMediation": "none",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessResidentKey": "not specified",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessAuthenticatorAttachment": "platform",
  "webAuthnPolicyPasswordlessAvoidSameAuthenticatorRegister": true,
  "localizationTexts": {
    "en": {
      "webauthn-registration-title": "パスキーを登録します。このパスキーで、次からのログインと、申込みの署名をします",
      "webauthn-registration-init-label": "パスキー",
      "deleteCredentialTitle": "{0} を消します",
      "deleteCredentialMessage": "{0} を保険会社から消しますか。消すと、このパスキーでは、ログインも申込みの署名もできなくなります。",
      "doConfirmDelete": "消す",
      "doDecline": "やめる",
      "doRegisterSecurityKey": "パスキーを登録する",
      "webauthn-doAuthenticate": "パスキーでログイン",
      "passkey-doAuthenticate": "パスキーでログイン"
    }
  },
