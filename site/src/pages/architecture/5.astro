---
import { ArrowRight, ClipboardCheck, Database, Lock, ScrollText, Tag } from "@lucide/astro";
import Slide from "../../layouts/Slide.astro";
import { doc } from "../../data/facts";

// architecture 2-1 の監査のための記録と、2-3 の記録の集約
const WRITERS = [
  { name: "ログインサーバー", rec: "ログインの証明の発行" },
  { name: "認可サーバー", rec: "代理の証明への交換" },
  { name: "事務サービス", rec: "ツールの呼び出し" },
  { name: "保険会社のシステム", rec: "契約" },
  { name: "営業 AI エージェント", rec: "会話（自己申告）", agent: true },
];
const GUARDS = [
  { icon: Lock, title: "書いた者は、書き換えられない", text: "各サービスは 1 行ずつ書き出すだけで、届いた後の記録に触れられない" },
  { icon: Tag, title: "書き手の印を、書いた者以外が付ける", text: "記録の集約が、書いた Pod の印を付ける。記録の中の名乗りは使わない" },
  { icon: ClipboardCheck, title: "種類ごとに、決まった書き手だけを認める", text: "監査サービスは、記録の種類と書き手の印を照らし、合わない記録を受け付けない" },
];
---

<Slide
  path="architecture/5/"
  lead="監査の根拠は、記録そのものの確かさに依ります。各サービスは記録を書き出すだけで、集めて保つのは別の部品です。書き手の印は、書いた者ではなく集める側が付け、監査は、記録の種類ごとに決まった書き手かを確かめます。"
  evidence={[
    { label: "architecture 2-1、2-3: 監査のための記録と、記録の集約", href: doc("architecture.md") },
    { label: "scenarios 2 章: 防御 G25（ほかのサービスを名乗る記録の偽装も確かめる）", href: doc("scenarios.md") },
    { label: "限界: 届いた後の書き換えは、クラスタの管理者を信頼する（architecture 6 章）", href: doc("architecture.md") },
  ]}
>
  <div class="grid items-center gap-4 lg:grid-cols-[1.2fr_auto_1fr_auto_1fr]" aria-label="記録の流れ。5 つのサービスが、それぞれの記録を 1 行ずつ書き出す。記録の集約が、書いた Pod の印を付けて、名前空間ごとの保存先に届ける。監査サービスだけが保存先を読み、記録の種類と書き手を照らして突き合わせる。">
    <ul class="grid gap-2">
      {
        WRITERS.map((w) => (
          <li class:list={["flex items-center justify-between gap-3 rounded-xl border-2 px-4 py-2.5 text-sm", w.agent ? "border-dashed border-agent/50 bg-agent-soft" : "bg-card"]}>
            <span class="font-semibold">{w.name}</span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground"><ScrollText class="size-4" aria-hidden="true" />{w.rec}</span>
          </li>
        ))
      }
    </ul>
    <ArrowRight class="mx-auto size-7 rotate-90 text-muted-foreground lg:rotate-0" aria-hidden="true" />
    <div class="rounded-3xl border-2 border-primary/40 bg-primary-soft p-5">
      <p class="flex items-center gap-2 font-bold"><Database class="size-6 text-primary" aria-hidden="true" />記録の集約</p>
      <ul class="mt-3 grid gap-1.5 text-sm">
        <li>書いた Pod の印を付ける</li>
        <li>名前空間ごとの保存先に届ける</li>
        <li>届けるのは集める者だけ、読むのは監査サービスだけ</li>
      </ul>
      <p class="mt-3 text-xs text-muted-foreground">この実装では Alloy と Loki</p>
    </div>
    <ArrowRight class="mx-auto size-7 rotate-90 text-muted-foreground lg:rotate-0" aria-hidden="true" />
    <div class="rounded-3xl border-2 bg-card p-5">
      <p class="flex items-center gap-2 font-bold"><ClipboardCheck class="size-6 text-primary" aria-hidden="true" />監査サービス</p>
      <p class="mt-3 text-sm">記録の種類と書き手を照らしてから、契約ごとに突き合わせる。会話の記録は、自己申告として示す</p>
    </div>
  </div>

  <ul class="mt-12 grid gap-4 md:grid-cols-3">
    {
      GUARDS.map((g) => (
        <li class="flex gap-4 rounded-2xl border-2 bg-card p-5">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-ok-soft text-ok"><g.icon class="size-6" aria-hidden="true" /></span>
          <span>
            <span class="block font-bold">{g.title}</span>
            <span class="mt-1 block text-sm text-muted-foreground">{g.text}</span>
          </span>
        </li>
      ))
    }
  </ul>
</Slide>
