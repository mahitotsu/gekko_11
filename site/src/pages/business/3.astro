---
import { Building, FileCheck, Inbox, Route, Signature, Smartphone, UserCheck } from "@lucide/astro";
import Mark from "../../components/figures/Mark.astro";
import Panel from "../../components/figures/Panel.astro";
import Slide from "../../layouts/Slide.astro";
import { doc } from "../../data/facts";

const STEPS = [
  { icon: Signature, who: "本人", what: "意向を確かめる書面に、自分の端末で署名する", when: "取引のとき" },
  { icon: Signature, who: "本人", what: "申込書に、自分の端末で署名する", when: "取引のとき" },
  { icon: Building, who: "会社", what: "署名と内容を確かめ、承認された内容のとおりに契約を記録する", when: "取引のとき" },
  { icon: Inbox, who: "会社", what: "契約内容を、AI を通さず、本人の端末へ直接届ける", when: "事後" },
  { icon: Smartphone, who: "本人", what: "届いた契約内容を、手元に残した写しと照らす。違えば知らせる", when: "事後" },
];
const PROVE = [
  { icon: UserCheck, label: "誰が", text: "本人の署名から、承認したのが本人だと示せる" },
  { icon: FileCheck, label: "何に", text: "署名した書類の中身と、記録した契約が一致すると示せる" },
  { icon: Route, label: "誰を通って", text: "どの AI エージェントが、どこを通して取り次いだかを示せる" },
];
---

<Slide
  path="business/3/"
  lead="本人は、意向を確かめる書面と申込書に、自分の端末で署名します。会社は、その内容のとおりに契約を記録し、AI を通さずに本人へ届けます。後から問われても、誰が、何に同意し、誰を通って届いたかを示せます。"
  evidence={[
    { label: "architecture 1-2 の要件 7、11、12", href: doc("architecture.md") },
    { label: "scenarios 3 章のシナリオ 10、19、20", href: doc("scenarios.md") },
    { label: "署名の法的な効力は、このリポジトリでは確かめていない" },
  ]}
>
  <ol class="grid gap-3 lg:grid-cols-5" aria-label="署名から事後の照合までの 5 つの段。1 と 2 で本人が書面と申込書に署名し、3 で会社が確かめて記録し、4 で会社が契約内容を AI を通さずに本人へ届け、5 で本人が手元の写しと照らす。">
    {
      STEPS.map((s, i) => (
        <li class:list={["relative flex flex-col rounded-2xl border-2 p-5", s.who === "本人" ? "border-ok/50 bg-ok-soft" : "border-primary/40 bg-primary-soft"]}>
          <span class="flex items-center justify-between">
            <span class="grid size-8 place-items-center rounded-full bg-card text-sm font-bold">{i + 1}</span>
            <span class="text-xs text-muted-foreground">{s.when}</span>
          </span>
          <span class:list={["mt-4 flex items-center gap-2 font-bold", s.who === "本人" ? "text-ok" : "text-primary"]}>
            <s.icon class="size-6" aria-hidden="true" />
            {s.who}
          </span>
          <span class="mt-2 text-sm leading-relaxed">{s.what}</span>
        </li>
      ))
    }
  </ol>
  <p class="mt-3 text-center text-sm text-muted-foreground">AI エージェントは書類を運ぶだけで、署名も、契約の記録も、契約内容の配達もしない</p>

  <Panel tone="neutral" class="mt-12">
    <p class="mb-5 flex flex-wrap items-center gap-3 text-lg font-bold">後から示せること <Mark kind="stopped" label="記録に残る" /></p>
    <div class="grid gap-4 sm:grid-cols-3">
      {
        PROVE.map((p) => (
          <div class="flex gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-primary-soft text-primary"><p.icon class="size-6" aria-hidden="true" /></span>
            <span>
              <span class="block font-bold">{p.label}</span>
              <span class="text-sm text-muted-foreground">{p.text}</span>
            </span>
          </div>
        ))
      }
    </div>
  </Panel>
</Slide>
